<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ru.pathcreator.vadim</groupId>
    <artifactId>quantum-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>quantum-chemistry-drawing</artifactId>
  <packaging>jar</packaging>

  <name>quantum-chemistry-drawing</name>
  <description>UI-independent molecule drawing, layout, and edit model.</description>

  <dependencies>
    <dependency>
      <groupId>com.actelion.research</groupId>
      <artifactId>openchemlib</artifactId>
      <version>2026.10.1</version>
      <exclusions>
        <exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.openscience.cdk</groupId>
      <artifactId>cdk-builder3d</artifactId>
      <version>2.12</version>
    </dependency>
    <dependency>
      <groupId>com.simolecule.centres</groupId>
      <artifactId>centres-cdk</artifactId>
      <version>1.5</version>
    </dependency>
    <dependency>
      <groupId>uk.ac.cam.ch.opsin</groupId>
      <artifactId>opsin-core</artifactId>
      <version>2.9.0</version>
    </dependency>
    <dependency>
      <groupId>org.openscience.cdk</groupId>
      <artifactId>cdk-ctab</artifactId>
      <version>2.12</version>
    </dependency>
    <dependency>
      <groupId>org.openscience.cdk</groupId>
      <artifactId>cdk-smiles</artifactId>
      <version>2.12</version>
    </dependency>
    <dependency>
      <groupId>org.openscience.cdk</groupId>
      <artifactId>cdk-isomorphism</artifactId>
      <version>2.12</version>
    </dependency>
    <dependency>
      <groupId>org.openscience.cdk</groupId>
      <artifactId>cdk-standard</artifactId>
      <version>2.12</version>
    </dependency>
    <dependency>
      <groupId>org.openscience.cdk</groupId>
      <artifactId>cdk-sdg</artifactId>
      <version>2.12</version>
    </dependency>
    <dependency>
      <groupId>org.openscience.cdk</groupId>
      <artifactId>cdk-silent</artifactId>
      <version>2.12</version>
    </dependency>
    <dependency>
      <groupId>ru.pathcreator.vadim</groupId>
      <artifactId>quantum-chemistry-core</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.7.0</version>
        <executions>
          <execution>
            <id>include-layout-library-sources</id>
            <phase>process-resources</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <includeGroupIds>org.openscience.cdk,javax.vecmath,uk.ac.ebi.beam,uk.ac.cam.ch.opsin,com.simolecule.centres,com.actelion.research</includeGroupIds>
              <classifier>sources</classifier>
              <failOnMissingClassifierArtifact>true</failOnMissingClassifierArtifact>
              <outputDirectory>${project.build.outputDirectory}/META-INF/quantum-third-party/sources</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
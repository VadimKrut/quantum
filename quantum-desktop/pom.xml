<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ru.pathcreator.vadim</groupId>
        <artifactId>quantum-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>quantum-desktop</artifactId>
    <packaging>jar</packaging>

    <name>quantum-desktop</name>
    <description>Native JavaFX workbench for Quantum IR workflows.</description>

    <properties>
        <desktop.distribution.name>Quantum IR Studio</desktop.distribution.name>
        <desktop.distribution.vendor>Vadim Aleksandrovich Zaletaev</desktop.distribution.vendor>
        <desktop.distribution.description>Native Quantum IR development studio.</desktop.distribution.description>
        <desktop.distribution.copyright>Copyright 2026 Vadim Aleksandrovich Zaletaev</desktop.distribution.copyright>
        <desktop.jpackage.executable>${java.home}${file.separator}bin${file.separator}jpackage</desktop.jpackage.executable>
        <desktop.jpackage.input>${project.build.directory}${file.separator}jpackage-input</desktop.jpackage.input>
        <desktop.jpackage.dist>${project.build.directory}${file.separator}dist</desktop.jpackage.dist>
        <desktop.jpackage.app.version>${project.version}</desktop.jpackage.app.version>
        <desktop.jpackage.prepare.skip>true</desktop.jpackage.prepare.skip>
        <desktop.icon.windows>${project.basedir}${file.separator}src${file.separator}main${file.separator}packaging${file.separator}windows${file.separator}quantum-ir-studio.ico</desktop.icon.windows>
        <desktop.icon.linux>${project.basedir}${file.separator}src${file.separator}main${file.separator}packaging${file.separator}linux${file.separator}quantum-ir-studio.png</desktop.icon.linux>
        <desktop.icon.macos>${project.basedir}${file.separator}src${file.separator}main${file.separator}packaging${file.separator}macos${file.separator}quantum-ir-studio.icns</desktop.icon.macos>
        <desktop.icon.current>${desktop.icon.linux}</desktop.icon.current>
    </properties>

    <dependencies>
        <dependency>
            <groupId>ru.pathcreator.vadim</groupId>
            <artifactId>quantum-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ru.pathcreator.vadim</groupId>
            <artifactId>quantum-simulation</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ru.pathcreator.vadim</groupId>
            <artifactId>quantum-library</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>ru.pathcreator.vadim.quantum.desktop.launcher.QuantumDesktopLauncher</mainClass>
                                    <manifestEntries>
                                        <Implementation-Title>Quantum IR Studio</Implementation-Title>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-jpackage-input</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${desktop.jpackage.prepare.skip}</skip>
                            <target>
                                <delete dir="${desktop.jpackage.input}" />
                                <delete dir="${desktop.jpackage.dist}" />
                                <mkdir dir="${desktop.jpackage.input}" />
                                <copy
                                    file="${project.build.directory}${file.separator}${project.build.finalName}.jar"
                                    todir="${desktop.jpackage.input}" />
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>desktop-platform-windows</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <desktop.icon.current>${desktop.icon.windows}</desktop.icon.current>
            </properties>
        </profile>
        <profile>
            <id>desktop-platform-macos</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <properties>
                <desktop.icon.current>${desktop.icon.macos}</desktop.icon.current>
            </properties>
        </profile>
        <profile>
            <id>dist-app-image</id>
            <properties>
                <desktop.jpackage.prepare.skip>false</desktop.jpackage.prepare.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jpackage-app-image</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${desktop.jpackage.executable}</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>app-image</argument>
                                        <argument>--input</argument>
                                        <argument>${desktop.jpackage.input}</argument>
                                        <argument>--dest</argument>
                                        <argument>${desktop.jpackage.dist}</argument>
                                        <argument>--name</argument>
                                        <argument>${desktop.distribution.name}</argument>
                                        <argument>--main-jar</argument>
                                        <argument>${project.build.finalName}.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>ru.pathcreator.vadim.quantum.desktop.launcher.QuantumDesktopLauncher</argument>
                                        <argument>--app-version</argument>
                                        <argument>${desktop.jpackage.app.version}</argument>
                                        <argument>--vendor</argument>
                                        <argument>${desktop.distribution.vendor}</argument>
                                        <argument>--description</argument>
                                        <argument>${desktop.distribution.description}</argument>
                                        <argument>--copyright</argument>
                                        <argument>${desktop.distribution.copyright}</argument>
                                        <argument>--icon</argument>
                                        <argument>${desktop.icon.current}</argument>
                                        <argument>--java-options</argument>
                                        <argument>-Dfile.encoding=UTF-8</argument>
                                        <argument>--java-options</argument>
                                        <argument>-Dsun.stdout.encoding=UTF-8</argument>
                                        <argument>--java-options</argument>
                                        <argument>-Dsun.stderr.encoding=UTF-8</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>dist-windows-exe</id>
            <properties>
                <desktop.jpackage.prepare.skip>false</desktop.jpackage.prepare.skip>
